---
import '../styles/global.css'
import '@fortawesome/fontawesome-free/css/all.min.css'
import TopNav from '../components/TopNav.astro'
import Sidebar from '../components/Sidebar.astro'
import Footer from '../components/Footer.astro'
import BackToTop from '../components/BackToTop.astro'
import type { NavData } from '../data/types'

interface Props {
  data: NavData
  showToggle?: boolean
}

const { data, showToggle = true } = Astro.props
const pageTitle = data.subtitle ? `${data.title} - ${data.subtitle}` : data.title

// 防止深色模式闪烁的内联脚本
const darkModeInit = `
(function() {
  try {
    var stored = localStorage.getItem('color-mode');
    if (stored === 'dark') {
      document.documentElement.classList.add('dark');
    }
  } catch (e) {}
})();
`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageTitle} />
    <meta name="keywords" content="导航站,软件,工具,书签" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageTitle} />
    <meta property="og:site_name" content={data.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <link rel="icon" href={data.favicon} />
    <slot name="head" />
    <script is:inline set:html={darkModeInit} />
  </head>
  <body>
    <div class="page-container">
      <!-- Mobile overlay -->
      <div id="sidebar-overlay" class="sidebar-overlay" data-mobile-open="false"></div>
      <Sidebar menu={data.menu} about={data.about} lastUpdate={data.lastUpdate} />
      <div class="main-content">
        <TopNav showToggle={showToggle} title={data.title} />
        <div class="content-wrapper px-4 py-2">
          <slot />
        </div>
        <Footer since={data.since} title={data.title} />
      </div>
      <BackToTop />
    </div>
    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>
