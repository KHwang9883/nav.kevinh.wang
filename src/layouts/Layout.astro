---
import '../styles/global.css'
import '@fortawesome/fontawesome-free/css/all.min.css'
import TopNav from '../components/TopNav.astro'
import Sidebar from '../components/Sidebar.astro'
import Footer from '../components/Footer.astro'
import BackToTop from '../components/BackToTop.astro'
import type { NavData } from '../data/types'

interface Props {
  data: NavData
  showToggle?: boolean
}

const { data, showToggle = true } = Astro.props

// 防止深色模式闪烁的内联脚本
const darkModeInit = `
(function() {
  try {
    var stored = localStorage.getItem('color-mode');
    if (stored === 'dark') {
      document.documentElement.classList.add('dark');
    }
  } catch (e) {}
})();
`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kevin Huang 的导航站 - 亲选软件与资源</title>
    <meta name="description" content="Kevin Huang 的个人导航站，亲选软件与资源" />
    <meta name="keywords" content="导航站,软件,工具,游戏,Kevin Huang" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Kevin Huang 的导航站 - 亲选软件与资源" />
    <meta property="og:description" content="Kevin Huang 的个人导航站，亲选软件与资源" />
    <meta property="og:site_name" content="Kevin Huang 的导航站" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kevin Huang 的导航站 - 亲选软件与资源" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />
    <script is:inline set:html={darkModeInit} />
  </head>
  <body>
    <div class="page-container">
      <!-- Mobile overlay -->
      <div id="sidebar-overlay" class="sidebar-overlay" data-mobile-open="false"></div>
      <Sidebar menu={data.menu} about={data.about} lastUpdate={data.lastUpdate} />
      <div class="main-content">
        <TopNav showToggle={showToggle} />
        <div class="content-wrapper px-4 py-2">
          <slot />
        </div>
        <Footer since={data.since} />
      </div>
      <BackToTop />
    </div>
    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>
