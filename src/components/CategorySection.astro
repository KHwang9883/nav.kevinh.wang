---
import LinkCard from './LinkCard.astro'
import type { NavItem } from '../data/types'

interface Props {
  name: string
  icon: string
  items: NavItem[]
  description?: string
}

const { name, icon, items, description } = Astro.props
const anchorId = name.replace(/\s+/g, '-')
---

<div id={anchorId} class="category-anchor">
  <div class="category-header">
    <i class={`${icon} category-icon`}></i>
    <div class="category-header-body">
      <h4 class="category-title">{name}</h4>
      {description && <p class="category-description">{description}</p>}
    </div>
  </div>
  <div class="nav-grid">
    {items.map((item) => (
      <LinkCard item={item} />
    ))}
  </div>
  <div class="mb-6"></div>
</div>
