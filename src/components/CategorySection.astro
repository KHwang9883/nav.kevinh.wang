---
import LinkCard from './LinkCard.astro'
import type { NavItem } from '../data/types'

interface Props {
  name: string
  icon: string
  items: NavItem[]
}

const { name, icon, items } = Astro.props
const anchorId = name.replace(/\s+/g, '-')
---

<div id={anchorId} class="category-anchor">
  <h4 class="category-title">
    <i class={icon} style="margin-right: 7px;"></i>
    <span>{name}</span>
  </h4>
  <div class="nav-grid">
    {items.map((item) => (
      <LinkCard item={item} />
    ))}
  </div>
  <div class="mb-6"></div>
</div>
