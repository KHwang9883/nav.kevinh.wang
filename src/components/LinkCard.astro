---
import type { NavItem } from '../data/types'

interface Props {
  item: NavItem
}

const { item } = Astro.props
const hasTags = item.foss || item.paid || item.affiliate || item.require_proxy || item.winget
---

<a href={item.url} target="_blank" rel="noopener noreferrer" class="nav-card" data-nav-card data-card-url={item.url}>
  <div class="nav-card-inner">
    <img
      src={item.img}
      alt={item.name}
      class="nav-card-img"
      loading="lazy"
      onerror="this.onerror=null;this.src='/images/missing.png'"
    />
    <div class="nav-card-text">
      <span class="nav-card-name">
        {item.name}
        {item.hot && <i class="fas fa-fire nav-card-name-tag hot" title="特别推荐"></i>}
        {item.abandoned && <i class="fas fa-stop-circle nav-card-name-tag abandoned" title="近期未使用"></i>}
      </span>
      <p class="nav-card-desc">{item.description}</p>
    </div>
    <!-- Tags: foss/paid/affiliate/require_proxy icons + winget button -->
    {hasTags && (
      <div class="nav-card-tags">
        {item.foss && <i class="fab fa-osi nav-card-tag foss" title="自由/开源软件"></i>}
        {item.paid && <i class="fas fa-dollar-sign nav-card-tag paid" title="收费"></i>}
        {item.affiliate && <i class="fas fa-user nav-card-tag affiliate" title="本人参与"></i>}
        {item.require_proxy === 'required' && <i class="fas fa-plane nav-card-tag proxy-required" title="国内需借助特殊手段"></i>}
        {item.require_proxy === 'optional' && <i class="fas fa-plane nav-card-tag proxy-optional" title="国内可能需特殊手段"></i>}
        {item.winget && (
          <button
            class="nav-card-winget"
            data-winget={item.winget}
            title="使用 winget 安装"
          >
            <i class="fas fa-download"></i>
            安装
          </button>
        )}
      </div>
    )}
  </div>
</a>
