---
interface Props {
  since: number
}

const { since } = Astro.props
const currentYear = new Date().getFullYear()
const sinceRange = since === currentYear ? String(since) : `${since} - ${currentYear}`
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-copyright">&copy; {sinceRange}</span>
      <a href="https://kevinh.wang/" class="footer-author" target="_blank">Kevin Huang</a>
      <span class="footer-divider">|</span>
      <span class="footer-credit">Powered by <a href="https://astro.build/" target="_blank">Astro</a></span>
    </div>
  </div>
</footer>
