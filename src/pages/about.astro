---
import Layout from '../layouts/Layout.astro'
import { getNavData } from '../data/load'

const data = getNavData()
const aboutPage = data.aboutPage
---

<Layout data={data} showToggle={false}>
  <div class="about-page">
    <!-- Main content -->
    <div class="about-content">
      <!-- Website info section -->
      {aboutPage?.website && (
        <section class="about-section">
          <div class="about-section-header">
            <span class="about-section-icon"><i class="fas fa-info-circle"></i></span>
            <h2 class="about-section-title">{aboutPage.website.head}</h2>
          </div>
          <div class="about-section-body">
            <div class="about-html" set:html={aboutPage.website.html}></div>
          </div>
        </section>
      )}

      <!-- Webmaster info section -->
      {aboutPage?.webmaster && (
        <section class="about-section">
          <div class="about-section-header">
            <span class="about-section-icon"><i class="fas fa-user-circle"></i></span>
            <h2 class="about-section-title">{aboutPage.webmaster.head}</h2>
          </div>
          <div class="about-section-body">
            <div
              class="webmaster-card"
              data-webmaster-url={aboutPage.webmaster.url}
              style="cursor:pointer"
            >
              <div class="webmaster-avatar-wrap">
                <img
                  src={aboutPage.webmaster.img}
                  alt={aboutPage.webmaster.name}
                  class="webmaster-avatar"
                />
              </div>
              <div class="webmaster-info">
                <h3 class="webmaster-name">{aboutPage.webmaster.name}</h3>
                <p class="webmaster-desc">{aboutPage.webmaster.description}</p>
                <span class="webmaster-link">
                  <i class="fas fa-external-link-alt"></i> 访问主页
                </span>
              </div>
            </div>
            {aboutPage.webmaster.html && (
              <div class="about-html mt-6" set:html={aboutPage.webmaster.html}></div>
            )}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
